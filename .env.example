# Cấu hình API Backend cho môi trường Local
# Khi chạy thật, hãy copy file này thành .env và chỉnh sửa nếu cần

# Dành cho máy ảo Android Emulator kết nối vào Backend máy tính:
API_BASE_URL_ANDROID=http://10.0.2.2:8080/api

# Dành cho iOS Simulator hoặc Web:
API_BASE_URL_IOS=http://localhost:8080/api
API_BASE_URL_WEB=http://localhost:8080/api

# Dành cho thiết bị thật (Chung Wi-Fi với máy tính, thay IP máy tính của bạn):
# API_BASE_URL_ANDROID=http://192.168.1.x:8080/api
